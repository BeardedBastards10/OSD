{
  "name": "firmware-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Firmware Builder (MGRS on OSD), packaged as an Android app with Capacitor",
  "scripts": {
    "build": "node -e \"const f=require('fs');f.rmSync('www',{recursive:true,force:true});f.cpSync('site','www',{recursive:true})\""
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0"
  }
}
